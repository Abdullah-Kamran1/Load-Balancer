# Copy to .env and adjust as needed.
# Per-backend values are set directly in docker-compose.yml; these are the
# defaults used when running the backend outside Compose, e.g.:
#   uvicorn app.main:app
# from the backend/ directory.

BACKEND_ID=backend-1
DEFAULT_WORK_DELAY_MS=50
MAX_DELAY_MS=60000
MAX_CONCURRENCY=8
